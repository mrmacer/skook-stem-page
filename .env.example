# Server-side contact form delivery (configure these in Vercel).
RESEND_API_KEY=re_replace_with_resend_api_key
CONTACT_FROM_EMAIL=STEM@Skook29 <website@your-verified-domain.example>
CONTACT_TO_EMAIL=maceg@iu29.org

# Schuylkill Living Lab -- Supabase backend.
# SUPABASE_URL and SUPABASE_ANON_KEY are served to the browser (read-only,
# RLS-protected) via api/config.js -- do not hardcode them in any .html/.js
# file. SUPABASE_SERVICE_ROLE_KEY is server-only: it is read by the
# api/submit-*.js functions and must NEVER be exposed to the client or
# committed anywhere. Run supabase/migrations/0001_living_lab_schema.sql
# in the Supabase SQL editor before setting these.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace_with_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
